<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The in-app updater is the only thing in the app that talks to the network: it reads the
         GitHub Releases API and streams the release APK when the user asks for an update. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Same updater: a downloaded APK has to be handed to the system installer, which always
         asks the user to confirm before anything is installed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The QR scanner: frames are analyzed in memory by an on-device model and are never saved
         or uploaded. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Both features optional, so devices without a camera or a flash still install — only the
         Scan QR entry is unavailable there, and the app offers manual and link entry instead. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.StitchAuthenticator">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shares only the downloaded update APK, out of the cache, for the installer intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
