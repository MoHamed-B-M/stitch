<?xml version="1.0" encoding="utf-8"?>
<!--
  What this provider can handle, read by the system from the service's meta-data
  (android.credentials.provider). Requests for capability types not listed here never reach
  the app.

  The prefixes are deliberately mixed: passwords use the framework constant
  android.credentials.TYPE_PASSWORD_CREDENTIAL, while the passkey type constant
  (PublicKeyCredential.TYPE_PUBLIC_KEY_CREDENTIAL) lives in the androidx.credentials library,
  so passkeys are declared as androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
